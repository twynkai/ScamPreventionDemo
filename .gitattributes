# Default behavior: treat all files as text and normalize line endings to LF
* text=auto eol=lf

# Explicitly enforce LF for code and configuration files
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Lock down model weights, checkpoints, and binary assets to prevent text conversion
*.pt binary
*.pth binary
*.h5 binary
*.bin binary
*.onnx binary
*.safetensors binary
*.pkl binary
*.npz binary
*.zip binary